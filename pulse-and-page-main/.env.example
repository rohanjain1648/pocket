# Copy this file to .env and fill in real values. Never commit .env.

# Fitbit — https://dev.fitbit.com/apps (register app -> Client ID/Secret)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_ACCESS_TOKEN=

# WHOOP — https://developer.whoop.com (Developer Dashboard -> create app)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=

# BLE — no credentials needed. Optional: filter by device name substring.
BLE_DEVICE_NAME_FILTER=

# Personal baselines used for stress classification
RESTING_HR_BASELINE=70
HRV_BASELINE=45

# Audio paths
INPUT_AUDIO_PATH=sample_narration.wav
OUTPUT_AUDIO_DIR=output_audio

# ElevenLabs (primary TTS — a distinct voice per wellbeing state)
# elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 (best quality) | eleven_turbo_v2_5 (faster/cheaper)
ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI fallback (gpt-4o-mini-tts) — platform.openai.com -> API keys
OPENAI_API_KEY=

# Groq fallback (Orpheus) — console.groq.com -> API Keys
GROQ_API_KEY=

# Which provider app.py should use: elevenlabs | openai | groq
TTS_PROVIDER=elevenlabs

# librosa pitch/tempo post-processing. Ignored for elevenlabs.
TONE_DSP=true
