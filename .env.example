# Groq (specialist agents, Adapter, Bible-Builder, Editor rewrite, and
# multi-voice audio via Orpheus TTS — this one key covers almost everything)
GROQ_API_KEY=

# Gemini (Story Bible / Consistency RAG — batched to one call per episode
# since the free tier caps at 20 generateContent requests/day/model)
GEMINI_API_KEY=

# OpenAI (embeddings for vector search — text-embedding-3-small has no daily
# cap, unlike Gemini's — plus gpt-image-1 for generated cover art. Not used
# for chat; Groq remains the hot path there.)
OPENAI_API_KEY=

# Database (local dev default; swap for Databricks-fed Postgres in prod)
DATABASE_URL="file:./dev.db"

# ElevenLabs (optional secondary TTS provider — selectable per render from
# the Studio, and the auto-fallback when Groq is unset or rate-limited.
# Free-tier accounts get a 402 on all library voices via the API; needs a
# paid plan. A key restricted to the text_to_speech scope (no voices_read)
# is fine — the app falls back to a curated, verified-working voice pool.)
ELEVENLABS_API_KEY=

# Max concurrent ElevenLabs TTS requests (default 2). ElevenLabs plans cap
# concurrency (e.g. 3 on Starter) and reject anything over it with a 429 —
# keep this at least 1 below your plan's limit.
ELEVENLABS_CONCURRENCY=

# Databricks (optional — sponsor-bonus integration; app runs fully local without these)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_RETENTION_MODEL_ENDPOINT=
DATABRICKS_VECTOR_SEARCH_ENDPOINT=
DATABRICKS_VECTOR_INDEX_NAME=
DATABRICKS_AUDIENCE_SIM_ENDPOINT=
